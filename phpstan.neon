includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    ignoreErrors:
        -
            identifier: trait.unused
            path: app/Jobs/Concerns/TenantAware.php
            count: 1

    level: 7